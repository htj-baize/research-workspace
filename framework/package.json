{
  "name": "@research-workspace/recommendation-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "build:types": "tsc -p ./tsconfig.build.json",
    "check:exports": "node -e \"import('./index.ts').then((m)=>console.log(JSON.stringify({ ok: !!m.buildReferenceRuntime })))\""
  },
  "exports": {
    ".": "./index.ts",
    "./core/*": "./core/*.ts",
    "./runtime/*": "./runtime/*.ts",
    "./storage/*": "./storage/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "core",
    "runtime",
    "storage",
    "README.md",
    "package.json"
  ]
}
